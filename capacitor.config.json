{
  "appId": "com.whipandwhisk.bakesale",
  "appName": "Whip & Whisk",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#f5ece4",
      "showSpinner": false
    }
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.onrender.com",
      "*.mongodb.net",
      "*.supabase.co",
      "*.vercel.app"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
